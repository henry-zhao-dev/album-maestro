{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:album-maestro:schema:album",
  "title": "Album Maestro album",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "genre", "tracks"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "artist": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Optional album artist default inherited by tracks without an artist. Null is used for compilations."
    },
    "genre": { "type": "string", "minLength": 1 },
    "composer": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Optional composer credit inherited by tracks without a track-level composer."
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "description": "Reference URL inherited by tracks without one."
    },
    "file_source": {
      "type": "string",
      "minLength": 1,
      "description": "Local audio path relative to the library, inherited by tracks without one."
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "anyOf": [
            { "required": ["url"] },
            { "required": ["file_source"] }
          ]
        }
      },
      "then": {
        "properties": {
          "tracks": {
            "items": {
              "anyOf": [
                { "required": ["url"] },
                { "required": ["file_source"] }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]+:){0,2}[0-9]+(?:\\.[0-9]+)?$"
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": { "$ref": "#/$defs/timestamp" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "artist": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Optional track artist override; inherits the album artist or Various Artists when absent."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Reference URL for this track."
        },
        "file_source": {
          "type": "string",
          "minLength": 1,
          "description": "Local audio path relative to the library."
        },
        "composer": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Optional composer override for this track."
        },
        "genre": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Optional genre override for this track."
        },
        "start": { "$ref": "#/$defs/timestamp" },
        "end": { "$ref": "#/$defs/timestamp" },
        "chapters": {
          "type": "array",
          "items": { "$ref": "#/$defs/chapter" }
        }
      }
    }
  }
}
