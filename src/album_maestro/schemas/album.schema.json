{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:album-maestro:schema:album",
  "title": "Album Maestro album",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "artist", "tracks"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "artist": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Canonical album artist reference inherited by tracks without an artist."
    },
    "genre": { "type": "string", "minLength": 1 },
    "url": {
      "type": "string",
      "minLength": 1,
      "description": "Shared source URL inherited by tracks without a URL."
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "allOf": [
    {
      "if": { "not": { "required": ["url"] } },
      "then": {
        "properties": {
          "tracks": { "items": { "required": ["url"] } }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]+:){0,2}[0-9]+(?:\\.[0-9]+)?$"
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start"],
      "properties": {
        "start": { "$ref": "#/$defs/timestamp" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "artist": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Optional canonical track artist reference; inherits the album artist."
        },
        "url": { "type": "string", "minLength": 1 },
        "start": { "$ref": "#/$defs/timestamp" },
        "end": { "$ref": "#/$defs/timestamp" },
        "chapters": {
          "type": "array",
          "items": { "$ref": "#/$defs/chapter" }
        }
      }
    }
  }
}
